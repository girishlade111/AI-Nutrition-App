'use client';

import React, { useState, useContext, createContext, useEffect, useMemo, ReactNode } from 'react';
import { IntakeData } from '@/app/lib/types';

export const DEFAULT_INTAKE_DATA: IntakeData = {
  age: '',
  gender: 'male',
  height: '',
  weight: '',
  goal: 'loss',
  activity: 'sedentary',
  dietType: 'veg',
  allergies: [],
  cheatFoods: '',
};

interface IntakeContextType {
  intakeData: IntakeData;
  updateIntake: (field: keyof IntakeData, value: any) => void;
  resetIntake: () => void;
}

const IntakeContext = createContext<IntakeContextType | null>(null);

export const IntakeProvider = ({ children }: { children: ReactNode }) => {
  const [intakeData, setIntakeData] = useState<IntakeData>(() => {
    if (typeof window === 'undefined') {
      return DEFAULT_INTAKE_DATA;
    }
    try {
      const savedData = localStorage.getItem('nutritionIntakeData');
      return savedData ? JSON.parse(savedData) : DEFAULT_INTAKE_DATA;
    } catch (error) {
      console.error("Failed to parse localStorage data:", error);
      return DEFAULT_INTAKE_DATA;
    }
  });

  // Save to localStorage whenever data changes
  useEffect(() => {
    localStorage.setItem('nutritionIntakeData', JSON.stringify(intakeData));
  }, [intakeData]);

  const updateIntake = (field: keyof IntakeData, value: any) => {
    setIntakeData((prev) => ({
      ...prev,
      [field]: value,
    }));
  };
  
  const resetIntake = () => {
    setIntakeData(DEFAULT_INTAKE_DATA);
    if (typeof window !== 'undefined') {
      localStorage.removeItem('nutritionIntakeData');
    }
  }

  const value = useMemo(() => ({ intakeData, updateIntake, resetIntake }), [intakeData]);

  return (
    <IntakeContext.Provider value={value}>
      {children}
    </IntakeContext.Provider>
  );
};

export const useIntake = () => {
  const context = useContext(IntakeContext);
  if (!context) {
    throw new Error('useIntake must be used within an IntakeProvider');
  }
  return context;
};
