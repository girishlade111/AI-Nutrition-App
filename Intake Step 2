'use client';

import React from 'react';
import { Button } from '@/app/components/ui/button';
import { Label } from '@/app/components/ui/label';
import { NativeSelect } from '@/app/components/ui/native-select';
import { Progress } from '@/app/components/ui/progress';
import { IconArrowLeft, IconChevronRight } from '@/app/components/icons';
import { PAGES, GOALS, ACTIVITY_LEVELS } from '@/app/lib/constants';
import { useIntake } from '@/app/context/IntakeContext';

interface PageProps {
  onNavigate: (page: string) => void;
}

export const IntakeStep2 = ({ onNavigate }: PageProps) => {
  const { intakeData, updateIntake } = useIntake();
  
  return (
    <div className="p-6 bg-gray-50 min-h-screen">
      <Button variant="ghost" size="sm" onClick={() => onNavigate(PAGES.INTAKE_STEP_1)} className="mb-4">
        <IconArrowLeft className="w-4 h-4 mr-2" /> Back
      </Button>
      <Progress value={66} className="mb-4" />
      <h2 className="text-2xl font-semibold text-gray-900">Step 2: Goals & Activity</h2>
      <p className="text-gray-600 mb-6">What are you aiming for?</p>
      
      <div className="space-y-6">
        <div className="space-y-2">
          <Label htmlFor="goal">Primary Goal</Label>
          <NativeSelect 
            id="goal"
            value={intakeData.goal}
            onChange={(e) => updateIntake('goal', e.target.value)}
          >
            {GOALS.map(goal => (
              <option key={goal.value} value={goal.value}>{goal.label}</option>
            ))}
          </NativeSelect>
        </div>
        
        <div className="space-y-2">
          <Label htmlFor="activity">Activity Level</Label>
          <NativeSelect 
            id="activity"
            value={intakeData.activity}
            onChange={(e) => updateIntake('activity', e.target.value)}
          >
            {ACTIVITY_LEVELS.map(level => (
              <option key={level.value} value={level.value}>{level.label}</option>
            ))}
          </NativeSelect>
        </div>
      </div>
      
      <div className="w-full pt-8 sticky bottom-4">
        <Button 
          className="w-full text-lg font-semibold" 
          size="lg"
          onClick={() => onNavigate(PAGES.INTAKE_STEP_3)}
        >
          Next <IconChevronRight className="w-5 h-5 ml-2" />
        </Button>
      </div>
    </div>
  );
};
