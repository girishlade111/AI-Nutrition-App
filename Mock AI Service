        personalizedPlan.moderationTip = {
          food: 'Misal Pav',
          tip: "Misal Pav is a great choice! To manage calories, ask for less 'farsan' on top and have it with just one pav. Pair it with buttermilk (Chaas) instead of a sugary drink."
