'use client';

import React, { ReactNode } from 'react';
import { cn } from '@/app/lib/utils';

export const Tabs = ({ children, className }: { children: ReactNode, className?: string }) => (
  <div className={cn("w-full", className)}>{children}</div>
);

export const TabsList = ({ children, className }: { children: ReactNode, className?: string }) => (
  <div
    className={cn(
      "inline-flex h-10 items-center justify-center rounded-md bg-gray-100 p-1 text-gray-600",
      className
    )}
  >
    {children}
  </div>
);

export const TabsTrigger = ({ children, className, isActive, ...props }: React.ButtonHTMLAttributes<HTMLButtonElement> & { isActive: boolean }) => (
  <button
    className={cn(
      "inline-flex items-center justify-center whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium ring-offset-white transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50",
      isActive && "bg-white text-orange-700 shadow-sm",
      className
    )}
    {...props}
  >
    {children}
  </button>
);

export const TabsContent = ({ children, className, isActive, ...props }: React.HTMLAttributes<HTMLDivElement> & { isActive: boolean }) => (
  <div
    className={cn(
      "mt-2 ring-offset-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-2",
      !isActive && "hidden",
      className
    )}
    {...props}
  >
    {children}
  </div>
);
