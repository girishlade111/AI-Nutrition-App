'use client';

import React from 'react';
import { Button } from '@/app/components/ui/button';
import { Input } from '@/app/components/ui/input';
import { Label } from '@/app/components/ui/label';
import { NativeSelect } from '@/app/components/ui/native-select';
import { Progress } from '@/app/components/ui/progress';
import { IconArrowLeft, IconCheck } from '@/app/components/icons';
import { PAGES, DIET_TYPES, ALLERGIES_OPTIONS } from '@/app/lib/constants';
import { useIntake } from '@/app/context/IntakeContext';
import { cn } from '@/app/lib/utils';

interface PageProps {
  onNavigate: (page: string) => void;
  onSubmit: () => void;
}

export const IntakeStep3 = ({ onNavigate, onSubmit }: PageProps) => {
  const { intakeData, updateIntake } = useIntake();

  const toggleAllergy = (allergy: string) => {
    const current = intakeData.allergies;
    const newAllergies = current.includes(allergy)
      ? current.filter(a => a !== allergy)
      : [...current, allergy];
    updateIntake('allergies', newAllergies);
  };
  
  return (
    <div className="p-6 bg-gray-50 min-h-screen">
      <Button variant="ghost" size="sm" onClick={() => onNavigate(PAGES.INTAKE_STEP_2)} className="mb-4">
        <IconArrowLeft className="w-4 h-4 mr-2" /> Back
      </Button>
      <Progress value={100} className="mb-4" />
      <h2 className="text-2xl font-semibold text-gray-900">Step 3: Preferences</h2>
      <p className="text-gray-600 mb-6">This helps us pick the right food for you.</p>
      
      <div className="space-y-6 pb-24">
        <div className="space-y-2">
          <Label htmlFor="dietType">Diet Type</Label>
          <NativeSelect 
            id="dietType"
            value={intakeData.dietType}
            onChange={(e) => updateIntake('dietType', e.target.value)}
          >
            {DIET_TYPES.map(diet => (
              <option key={diet.value} value={diet.value}>{diet.label}</option>
            ))}
          </NativeSelect>
        </div>
        
        <div className="space-y-2">
          <Label>Allergies / Dislikes</Label>
          <div className="flex flex-wrap gap-2">
            {ALLERGIES_OPTIONS.map(allergy => {
              const isSelected = intakeData.allergies.includes(allergy);
              return (
                <Button
                  key={allergy}
                  variant={isSelected ? 'default' : 'outline'}
                  size="sm"
                  onClick={() => toggleAllergy(allergy)}
                  className={cn(
                    "rounded-full",
                    isSelected && "bg-orange-600 text-white"
                  )}
                >
                  {isSelected && <IconCheck className="w-4 h-4 mr-1.5" />}
                  {allergy}
                </Button>
              );
            })}
          </div>
        </div>
        
        <div className="space-y-2">
          <Label htmlFor="cheatFoods">Favorite "Cheat" Foods</Label>
          <Input 
            id="cheatFoods" 
            type="text" 
            placeholder="e.g., Vada Pav, Misal, Puran Poli" 
            value={intakeData.cheatFoods}
            onChange={(e) => updateIntake('cheatFoods', e.target.value)}
          />
          <p className="text-xs text-gray-500">We'll help you moderate them, not remove them!</p>
        </div>
      </div>
      
      <div className="w-full p-4 bg-gray-50 fixed bottom-0 left-0 border-t border-gray-200">
        <Button 
          className="w-full text-lg font-semibold" 
          size="lg"
          onClick={onSubmit}
        >
          Generate My Plan
        </Button>
      </div>
    </div>
  );
};
