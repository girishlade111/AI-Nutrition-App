'use client';

import React, { useState, useCallback } from 'react';
import { useIntake } from '@/app/context/IntakeContext';
import { PAGES } from '@/app/lib/constants';
import { AiPlan } from '@/app/lib/types';
import { fetchAiPlan } from '@/app/services/mockAi';

// Import Page Components
import { LandingPage } from '@/app/components/pages/LandingPage';
import { OnboardingPage } from '@/app/components/pages/OnboardingPage';
import { IntakeStep1 } from '@/app/components/pages/IntakeStep1';
import { IntakeStep2 } from '@/app/components/pages/IntakeStep2';
import { IntakeStep3 } from '@/app/components/pages/IntakeStep3';
import { GeneratingPlanPage } from '@/app/components/pages/GeneratingPlanPage';
import { DashboardPage } from '@/app/components/pages/DashboardPage';

export default function HomePage() {
  const [page, setPage] = useState(PAGES.LANDING);
  const [isLoading, setIsLoading] = useState(false);
  const [plan, setPlan] = useState<AiPlan | null>(null);
  
  const { intakeData, resetIntake } = useIntake();

  const handleNavigate = (targetPage: string) => {
    setPage(targetPage);
    window.scrollTo(0, 0);
  };
  
  const handleSubmitIntake = useCallback(async () => {
    handleNavigate(PAGES.GENERATING);
    setIsLoading(true);
    try {
      const generatedPlan = await fetchAiPlan(intakeData);
      setPlan(generatedPlan);
      handleNavigate(PAGES.DASHBOARD);
    } catch (error) {
      console.error("Failed to generate plan:", error);
      handleNavigate(PAGES.INTAKE_STEP_3); // Go back to form on error
    } finally {
      setIsLoading(false);
    }
  }, [intakeData]);
  
  const handleReset = () => {
    resetIntake();
    setPlan(null);
    handleNavigate(PAGES.LANDING);
  }

  const renderPage = () => {
    switch (page) {
      case PAGES.LANDING:
        return <LandingPage onNavigate={handleNavigate} />;
      case PAGES.ONBOARDING:
        return <OnboardingPage onNavigate={handleNavigate} />;
      case PAGES.INTAKE_STEP_1:
        return <IntakeStep1 onNavigate={handleNavigate} />;
      case PAGES.INTAKE_STEP_2:
        return <IntakeStep2 onNavigate={handleNavigate} />;
      case PAGES.INTAKE_STEP_3:
        return <IntakeStep3 onNavigate={handleNavigate} onSubmit={handleSubmitIntake} />;
      case PAGES.GENERATING:
        return <GeneratingPlanPage />;
      case PAGES.DASHBOARD:
        return plan ? <DashboardPage plan={plan} onReset={handleReset} /> : <GeneratingPlanPage />;
      default:
        return <LandingPage onNavigate={handleNavigate} />;
    }
  };

  return (
    <>
      {renderPage()}
    </>
  );
}
